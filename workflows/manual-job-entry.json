    {
      "parameters": {
        "jsCode": "const normalized = $(\"Normalize Manual Job Input\").first().json;\nconst text = (value) => String(value ?? \"\").trim();\n\nconst firstValue = (source, names) => {\n  for (const name of names) {\n    const value = source?.[name];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") {\n      return value;\n    }\n  }\n  return \"\";\n};\n\nlet scraped = {};\n\nif (normalized.needsLinkedInEnrichment) {\n  const response = $input.first().json;\n  const rows = Array.isArray(response)\n    ? response\n    : Array.isArray(response?.data)\n      ? response.data\n      : Array.isArray(response?.items)\n        ? response.items\n        : [response];\n\n  scraped = rows.find((row) => row && typeof row === \"object\" && !row.error) ?? {};\n\n  if (!scraped || Object.keys(scraped).length === 0) {\n    throw new Error(\"The LinkedIn scraper returned no job data.\");\n  }\n}\n\nconst companyName =\n  text(normalized.companyName) ||\n  text(firstValue(scraped, [\"companyName\", \"company\", \"company_name\"]));\n\nconst jobTitle =\n  text(normalized.jobTitle) ||\n  text(firstValue(scraped, [\"title\", \"jobTitle\", \"job_title\"]));\n\nconst jobDescription =\n  text(normalized.jobDescription) ||\n  text(firstValue(scraped, [\n    \"descriptionText\",\n    \"description\",\n    \"jobDescription\",\n    \"job_description\",\n  ]));\n\nif (!companyName || !jobTitle || !jobDescription) {\n  throw new Error(\n    \"The LinkedIn job could not be enriched with company name, job title, and full description. Enter the missing fields manually.\"\n  );\n}\n\nconst scrapedUrl = text(firstValue(scraped, [\"jobUrl\", \"url\", \"inputUrl\"]));\nconst scrapedJobId = text(firstValue(scraped, [\"jobId\", \"id\", \"job_id\"]));\nconst urlJobIdMatch = normalized.jobUrl.match(/(?:currentJobId=|\\/view\\/(?:[^/?#]*-)?)(\\d{6,})/);\n\nreturn [\n  {\n    json: {\n      companyName,\n      jobTitle,\n      jobDescription,\n      jobUrl: text(normalized.jobUrl) || scrapedUrl,\n      location:\n        text(normalized.location) ||\n        text(firstValue(scraped, [\"location\", \"jobLocation\"])),\n      contractType:\n        text(normalized.contractType) ||\n        text(firstValue(scraped, [\"employmentType\", \"contractType\", \"employment_type\"])),\n      publishedAt:\n        text(normalized.publishedAt) ||\n        text(firstValue(scraped, [\"postedAt\", \"publishedAt\", \"postedDate\", \"published_at\"])),\n      jobId:\n        text(normalized.jobId) ||\n        scrapedJobId ||\n        text(urlJobIdMatch?.[1]),\n      source: normalized.needsLinkedInEnrichment ? \"LinkedIn URL\" : normalized.source,\n      master_cv: normalized.master_cv,\n    },\n  },\n];"
      },
      "id": "0bf0c515-0004-422d-a46b-95b3c30f852a",
      "name": "Finalize Job Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        432
      ]
    },
    {
      "parameters": {
        "jsCode": "const webhook = $input.first().json;\nconst form = webhook?.body && typeof webhook.body === \"object\" ? webhook.body : webhook;\nconst text = (value) => String(value ?? \"\").trim();\nconst firstValue = (source, names) => {\n  for (const name of names) {\n    const value = source?.[name];\n    if (value !== undefined && value !== null && text(value) !== \"\") return value;\n  }\n  return \"\";\n};\n\nconst entryType = text(firstValue(form, [\"Entry Type\", \"entry_type\", \"entryType\"])) || \"External\";\nconst jobUrl = text(firstValue(form, [\"Job URL\", \"job_url\", \"jobUrl\"]));\nconst companyName = text(firstValue(form, [\"Company Name\", \"company_name\", \"companyName\"]));\nconst jobTitle = text(firstValue(form, [\"Job Title\", \"job_title\", \"jobTitle\"]));\nconst jobDescription = text(firstValue(form, [\"Job Description\", \"job_description\", \"jobDescription\"]));\n\nlet error = \"\";\nif (![\"External\", \"LinkedIn\"].includes(entryType)) {\n  error = \"Entry Type must be External or LinkedIn.\";\n} else if (!jobUrl) {\n  error = \"Job URL is required.\";\n} else {\n  let parsedUrl;\n  try { parsedUrl = new URL(jobUrl); } catch { error = \"Job URL must be a valid URL.\"; }\n  if (!error && entryType === \"LinkedIn\") {\n    const hostname = parsedUrl.hostname.toLowerCase();\n    const isLinkedIn = hostname === \"linkedin.com\" || hostname.endsWith(\".linkedin.com\");\n    if (!isLinkedIn) error = \"LinkedIn entry type requires a linkedin.com job URL.\";\n  }\n  if (!error && entryType === \"External\" && (!companyName || !jobTitle || !jobDescription)) {\n    error = \"External entries require Company Name, Job Title, Job Description, and Job URL.\";\n  }\n}\n\nreturn [{ json: { valid: !error, message: error, form } }];"
      },

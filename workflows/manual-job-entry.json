    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "import re\n\n\nif not _items:\n    raise ValueError(\"Prepare CV Content Input received no items.\")\n\njob = _items[0].get(\"json\", {})\nmaster_cv = job.get(\"master_cv\")\n\nif not isinstance(master_cv, dict):\n    raise ValueError(\"master_cv must be an object.\")\n\nif not isinstance(master_cv.get(\"projects\"), list):\n    raise ValueError(\"master_cv.projects must be an array.\")\n\nif not isinstance(master_cv.get(\"work_experience\"), list):\n    raise ValueError(\"master_cv.work_experience must be an array.\")\n\nif not isinstance(master_cv.get(\"skills\"), list):\n    raise ValueError(\"master_cv.skills must be an array.\")\n\n\ndef slugify(value):\n    normalized = str(value or \"\").lower().strip()\n    normalized = re.sub(r\"[^a-z0-9]+\", \"-\", normalized)\n    normalized = re.sub(r\"-+\", \"-\", normalized).strip(\"-\")\n    return normalized or \"unknown\"\n\n\njob_id = str(job.get(\"jobId\") or \"\").strip() or slugify(job.get(\"jobUrl\"))\napplication_id = (\n    f\"{slugify(job.get('companyName'))}-\"\n    f\"{slugify(job.get('jobTitle'))}-\"\n    f\"{slugify(job_id)}\"\n)\n\nreturn [\n    {\n        \"json\": {\n            \"test_mode\": False,\n            \"job_id\": job_id,\n            \"company_name\": job.get(\"companyName\"),\n            \"job_title\": job.get(\"jobTitle\"),\n            \"job_description\": job.get(\"jobDescription\"),\n            \"job_url\": job.get(\"jobUrl\"),\n            \"published_at\": job.get(\"publishedAt\"),\n            \"location\": job.get(\"location\"),\n            \"contract_type\": job.get(\"contractType\"),\n            \"application_id\": application_id,\n            \"project_selection_count\": 4,\n            \"work_experience_selection_count\": 3,\n            \"master_cv\": master_cv,\n            \"source_job\": job,\n        }\n    }\n]"
      },

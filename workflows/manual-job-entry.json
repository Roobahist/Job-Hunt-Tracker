    {
      "parameters": {
        "jsCode": "const extracted = $(\"Extract Master CV\").first().json;\nconst form = $(\"Validate Job Submission\").first().json.form;\n\nconst parseJson = (value) => {\n  if (typeof value !== \"string\") return value;\n  try { return JSON.parse(value); } catch { return value; }\n};\n\nconst unwrapMasterCv = (value) => {\n  let current = parseJson(value);\n  for (let depth = 0; depth < 5; depth++) {\n    if (!current || typeof current !== \"object\" || Array.isArray(current)) break;\n    if (Array.isArray(current.projects)) return current;\n    const next = current.master_cv ?? current.cv_json ?? current.document_data ?? current.data ?? current.json;\n    if (next === undefined || next === current) break;\n    current = parseJson(next);\n  }\n  return current;\n};\n\nconst firstValue = (source, names) => {\n  for (const name of names) {\n    const value = source?.[name];\n    if (value !== undefined && value !== null && String(value).trim() !== \"\") return value;\n  }\n  return \"\";\n};\n\nconst text = (value) => String(value ?? \"\").trim();\nconst masterCv = unwrapMasterCv(extracted);\nif (!masterCv || typeof masterCv !== \"object\" || Array.isArray(masterCv)) {\n  throw new Error(\"The master CV file must contain a JSON object.\");\n}\nif (!Array.isArray(masterCv.projects)) {\n  throw new Error(\"The master CV JSON could not be normalized: projects must be an array.\");\n}\n\nconst entryType = text(firstValue(form, [\"Entry Type\", \"entry_type\", \"entryType\"])) || \"External\";\nif (![\"External\", \"LinkedIn\"].includes(entryType)) {\n  throw new Error(\"Entry Type must be External or LinkedIn.\");\n}\n\nconst jobUrl = text(firstValue(form, [\"Job URL\", \"job_url\", \"jobUrl\"]));\nif (!jobUrl) throw new Error(\"Job URL is required.\");\n\nlet parsedUrl;\ntry { parsedUrl = new URL(jobUrl); } catch { throw new Error(\"Job URL must be a valid URL.\"); }\n\nconst companyName = text(firstValue(form, [\"Company Name\", \"company_name\", \"companyName\"]));\nconst jobTitle = text(firstValue(form, [\"Job Title\", \"job_title\", \"jobTitle\"]));\nconst jobDescription = text(firstValue(form, [\"Job Description\", \"job_description\", \"jobDescription\"]));\nconst isLinkedInUrl = parsedUrl.hostname === \"linkedin.com\" || parsedUrl.hostname.endsWith(\".linkedin.com\");\n\nif (entryType === \"LinkedIn\" && !isLinkedInUrl) {\n  throw new Error(\"LinkedIn entry type requires a linkedin.com job-post URL.\");\n}\nif (entryType === \"External\" && (!companyName || !jobTitle || !jobDescription)) {\n  throw new Error(\"External entries require Company Name, Job Title, Job Description, and Job URL.\");\n}\n\nreturn [{\n  json: {\n    entryType,\n    companyName,\n    jobTitle,\n    jobDescription,\n    jobUrl,\n    location: text(firstValue(form, [\"Location\", \"location\"])),\n    contractType: text(firstValue(form, [\"Contract Type\", \"contract_type\", \"contractType\"])),\n    publishedAt: text(firstValue(form, [\"Published Date\", \"published_at\", \"publishedAt\"])),\n    jobId: text(firstValue(form, [\"External Job ID\", \"job_id\", \"jobId\"])),\n    source: entryType === \"LinkedIn\" ? \"LinkedIn URL\" : \"Manual Form\",\n    needsLinkedInEnrichment: entryType === \"LinkedIn\",\n    master_cv: masterCv,\n  },\n}];"
      },

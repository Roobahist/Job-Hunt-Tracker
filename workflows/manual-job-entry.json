      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Add a Job</title>\n  <style>\n    :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f5f6f8; color: #202124; }\n    .card { width: min(760px, calc(100% - 32px)); background: white; border: 1px solid #dadce0; border-radius: 14px; padding: 28px; box-sizing: border-box; box-shadow: 0 8px 28px rgba(0,0,0,.08); }\n    h1 { margin: 0 0 8px; font-size: 26px; }\n    .intro { margin: 0 0 24px; color: #5f6368; line-height: 1.5; }\n    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }\n    .field { display: flex; flex-direction: column; gap: 7px; }\n    .full { grid-column: 1 / -1; }\n    label { font-size: 14px; font-weight: 650; }\n    .required::after { content: \" *\"; color: #b3261e; }\n    input, select, textarea { width: 100%; box-sizing: border-box; border: 1px solid #bdc1c6; border-radius: 8px; padding: 11px 12px; font: inherit; background: white; color: #202124; }\n    textarea { min-height: 210px; resize: vertical; }\n    input:focus, select:focus, textarea:focus { outline: 2px solid #1a73e8; border-color: transparent; }\n    .hidden { display: none; }\n    button { margin-top: 22px; border: 0; border-radius: 8px; padding: 12px 18px; font: inherit; font-weight: 700; background: #1a73e8; color: white; cursor: pointer; }\n    button:disabled { opacity: .65; cursor: wait; }\n    #status { min-height: 24px; margin-top: 14px; font-size: 14px; }\n    .success { color: #137333; }\n    .error { color: #b3261e; }\n    @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } .full { grid-column: auto; } .card { padding: 20px; } }\n    @media (prefers-color-scheme: dark) {\n      body { background: #111315; color: #e8eaed; }\n      .card { background: #1f2225; border-color: #3c4043; }\n      .intro { color: #bdc1c6; }\n      input, select, textarea { background: #202124; color: #e8eaed; border-color: #5f6368; }\n    }\n  </style>\n</head>\n<body>\n  <main class=\"card\">\n    <h1>Add a Job</h1>\n    <p class=\"intro\">Choose how the job should be entered. LinkedIn requires only the job-post URL. External jobs require the core job details.</p>\n    <form id=\"jobForm\">\n      <div class=\"grid\">\n        <div class=\"field full\">\n          <label class=\"required\" for=\"entryType\">Entry type</label>\n          <select id=\"entryType\" name=\"Entry Type\" required>\n            <option value=\"External\" selected>External</option>\n            <option value=\"LinkedIn\">LinkedIn</option>\n          </select>\n        </div>\n\n        <div class=\"field full\">\n          <label class=\"required\" id=\"jobUrlLabel\" for=\"jobUrl\">Job URL</label>\n          <input id=\"jobUrl\" name=\"Job URL\" type=\"url\" placeholder=\"https://...\" required>\n        </div>\n\n        <div id=\"externalFields\" class=\"full grid\">\n          <div class=\"field\">\n            <label class=\"required\" for=\"companyName\">Company name</label>\n            <input id=\"companyName\" name=\"Company Name\" placeholder=\"Example: Alberta Health Services\">\n          </div>\n          <div class=\"field\">\n            <label class=\"required\" for=\"jobTitle\">Job title</label>\n            <input id=\"jobTitle\" name=\"Job Title\" placeholder=\"Example: Data Scientist\">\n          </div>\n          <div class=\"field full\">\n            <label class=\"required\" for=\"jobDescription\">Job description</label>\n            <textarea id=\"jobDescription\" name=\"Job Description\" placeholder=\"Paste the complete job description\"></textarea>\n          </div>\n          <div class=\"field\">\n            <label for=\"location\">Location</label>\n            <input id=\"location\" name=\"Location\" placeholder=\"Example: Calgary, AB\">\n          </div>\n          <div class=\"field\">\n            <label for=\"contractType\">Contract type</label>\n            <select id=\"contractType\" name=\"Contract Type\">\n              <option value=\"\">Not specified</option>\n              <option>Full-time</option><option>Part-time</option><option>Contract</option>\n              <option>Temporary</option><option>Internship</option><option>Other</option>\n            </select>\n          </div>\n          <div class=\"field\">\n            <label for=\"publishedDate\">Published date</label>\n            <input id=\"publishedDate\" name=\"Published Date\" type=\"date\">\n          </div>\n          <div class=\"field\">\n            <label for=\"externalJobId\">External job ID</label>\n            <input id=\"externalJobId\" name=\"External Job ID\" placeholder=\"Optional job-board or employer ID\">\n          </div>\n        </div>\n      </div>\n      <button id=\"submitButton\" type=\"submit\">Process Job</button>\n      <div id=\"status\" role=\"status\" aria-live=\"polite\"></div>\n    </form>\n  </main>\n  <script>\n    const form = document.getElementById('jobForm');\n    const entryType = document.getElementById('entryType');\n    const externalFields = document.getElementById('externalFields');\n    const jobUrl = document.getElementById('jobUrl');\n    const jobUrlLabel = document.getElementById('jobUrlLabel');\n    const companyName = document.getElementById('companyName');\n    const jobTitle = document.getElementById('jobTitle');\n    const jobDescription = document.getElementById('jobDescription');\n    const button = document.getElementById('submitButton');\n    const status = document.getElementById('status');\n\n    function updateMode() {\n      const external = entryType.value === 'External';\n      externalFields.classList.toggle('hidden', !external);\n      externalFields.setAttribute('aria-hidden', String(!external));\n\n      companyName.required = external;\n      jobTitle.required = external;\n      jobDescription.required = external;\n\n      for (const control of externalFields.querySelectorAll('input, select, textarea')) {\n        control.disabled = !external;\n      }\n\n      jobUrlLabel.textContent = external ? 'Job URL' : 'LinkedIn job URL';\n      jobUrl.placeholder = external ? 'https://...' : 'https://www.linkedin.com/jobs/view/...';\n      jobUrl.setAttribute('aria-label', jobUrlLabel.textContent);\n    }\n\n    entryType.addEventListener('change', updateMode);\n    updateMode();\n\n    form.addEventListener('submit', async (event) => {\n      event.preventDefault();\n      if (!form.reportValidity()) return;\n\n      button.disabled = true;\n      status.className = '';\n      status.textContent = 'Submitting...';\n\n      const payload = Object.fromEntries(new FormData(form).entries());\n      if (payload['Entry Type'] === 'LinkedIn') {\n        for (const key of ['Company Name','Job Title','Job Description','Location','Contract Type','Published Date','External Job ID']) {\n          delete payload[key];\n        }\n      }\n\n      try {\n        const endpoint = `${window.location.origin}${window.location.pathname.replace(/\\/manual-job-entry\\/?$/, '/manual-job-entry-submit')}`;\n        const response = await fetch(endpoint, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify(payload)\n        });\n        const result = await response.json().catch(() => ({}));\n        if (!response.ok) throw new Error(result.message || `Submission failed with status ${response.status}.`);\n        status.className = 'success';\n        status.textContent = result.message || 'Job submitted successfully.';\n        form.reset();\n        entryType.value = 'External';\n        updateMode();\n      } catch (error) {\n        status.className = 'error';\n        status.textContent = error.message || 'The job could not be submitted.';\n      } finally {\n        button.disabled = false;\n      }\n    });\n  </script>\n</body>\n</html>",

        "pythonCode": "import re\n\n\ndef slugify(value):\n    text = str(value if value is not None else \"\").lower().strip()\n    text = re.sub(r\"[^a-z0-9]+\", \"-\", text)\n    text = re.sub(r\"-+\", \"-\", text).strip(\"-\")\n    return text or \"unknown\"\n\n\njob = _input.first().json\nmaster_cv = job.get(\"_pipeline_master_cv\")\nif not isinstance(master_cv, dict):\n    raise ValueError(\"master_cv must be an object.\")\nif not isinstance(master_cv.get(\"projects\"), list):\n    raise ValueError(\"master_cv.projects must be an array.\")\nif not isinstance(master_cv.get(\"work_experience\"), list):\n    raise ValueError(\"master_cv.work_experience must be an array.\")\nif not isinstance(master_cv.get(\"skills\"), list):\n    raise ValueError(\"master_cv.skills must be an array.\")\n\njob_id = str(job.get(\"jobId\") or \"\").strip() or slugify(job.get(\"jobUrl\"))\napplication_id = \"-\".join((slugify(job.get(\"companyName\")), slugify(job.get(\"jobTitle\")), slugify(job_id)))\nsource_job = {key: value for key, value in job.items() if key != \"_pipeline_master_cv\"}\nreturn [{\"json\": {\n    \"test_mode\": False,\n    \"job_id\": job_id,\n    \"company_name\": job.get(\"companyName\"),\n    \"job_title\": job.get(\"jobTitle\"),\n    \"job_description\": job.get(\"jobDescription\"),\n    \"job_url\": job.get(\"jobUrl\"),\n    \"published_at\": job.get(\"publishedAt\"),\n    \"location\": job.get(\"location\"),\n    \"contract_type\": job.get(\"contractType\"),\n    \"application_id\": application_id,\n    \"project_selection_count\": 4,\n    \"work_experience_selection_count\": 3,\n    \"master_cv\": master_cv,\n    \"source_job\": source_job,\n}}]\n"

      "parameters": {
        "jsCode": "const createdRow = $input.first().json;\nconst job = $(\"Keep Only New Job\").item.json;\n\nif (!createdRow?.id) {\n  throw new Error(\"The initial Baserow row was created without returning a row ID.\");\n}\n\nreturn [{\n  json: {\n    ...job,\n    baserow_row_id: createdRow.id\n  }\n}];"
      },

        "pythonCode": "import re\n\n\ndef canonical(value):\n    normalized = str(value if value is not None else \"\").strip()\n    normalized = re.sub(r\"[?#].*$\", \"\", normalized)\n    normalized = re.sub(r\"/$\", \"\", normalized)\n    return normalized.lower()\n\n\njob = None\nexisting_rows = []\nfor item in _input.all():\n    item_json = item.json\n    if not isinstance(item_json, dict):\n        continue\n    if \"jobUrl\" in item_json:\n        job = item_json\n        continue\n    fields = item_json.get(\"fields\")\n    row = fields if isinstance(fields, dict) else item_json\n    if \"Link\" in row:\n        existing_rows.append(row)\n\nif job is None:\n    raise ValueError(\"The current scraped job was not found in the node input.\")\ntarget = canonical(job.get(\"jobUrl\"))\nif not target:\n    return [{\"json\": {}}]\nif any(canonical(row.get(\"Link\")) == target for row in existing_rows):\n    return [{\"json\": {}}]\nreturn [{\"json\": job}]\n"
      },

    {
      "parameters": {
        "jsCode": "const extracted = $(\"Extract Master CV\").first().json;\n\nconst parseJson = (value) => {\n  if (typeof value !== \"string\") return value;\n\n  try {\n    return JSON.parse(value);\n  } catch {\n    return value;\n  }\n};\n\nconst unwrapMasterCv = (value) => {\n  let current = parseJson(value);\n\n  for (let depth = 0; depth < 5; depth++) {\n    if (!current || typeof current !== \"object\" || Array.isArray(current)) {\n      break;\n    }\n\n    if (Array.isArray(current.projects)) {\n      return current;\n    }\n\n    const next =\n      current.master_cv ??\n      current.cv_json ??\n      current.document_data ??\n      current.data ??\n      current.json;\n\n    if (next === undefined || next === current) {\n      break;\n    }\n\n    current = parseJson(next);\n  }\n\n  return current;\n};\n\nconst masterCv = unwrapMasterCv(extracted);\n\nif (!masterCv || typeof masterCv !== \"object\" || Array.isArray(masterCv)) {\n  throw new Error(\"The master CV file must contain a JSON object.\");\n}\n\nif (!Array.isArray(masterCv.projects)) {\n  throw new Error(\n    \"The master CV JSON could not be normalized: projects must be an array.\"\n  );\n}\n\nconst isTrue = (value) => {\n  if (typeof value === \"boolean\") return value;\n  if (typeof value === \"number\") return value === 1;\n\n  if (value && typeof value === \"object\") {\n    value = value.value ?? value.name ?? value.id;\n  }\n\n  return [\"true\", \"1\", \"yes\", \"active\", \"enabled\"].includes(\n    String(value ?? \"\").trim().toLowerCase()\n  );\n};\n\nconst seen = new Set();\nconst startUrls = [];\n\nfor (const item of $input.all()) {\n  const row =\n    item.json.fields && typeof item.json.fields === \"object\"\n      ? item.json.fields\n      : item.json;\n\n  const url = row[\"Generated URL\"];\n\n  if (!isTrue(row.Active) || typeof url !== \"string\" || !url.trim()) {\n    continue;\n  }\n\n  const normalized = url.trim();\n\n  if (!seen.has(normalized)) {\n    seen.add(normalized);\n    startUrls.push({ url: normalized });\n  }\n}\n\nif (startUrls.length === 0) {\n  throw new Error(\n    \"No active Search Criteria rows contain a Generated URL.\"\n  );\n}\n\nreturn [\n  {\n    json: {\n      master_cv: masterCv,\n      startUrls,\n    },\n  },\n];"
      },

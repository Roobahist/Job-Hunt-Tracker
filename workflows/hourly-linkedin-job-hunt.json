        "mode": "runOnceForAllItems",
        "language": "pythonNative",
        "pythonCode": "from datetime import datetime, timezone\n\n\ndef require_upload(upload, label):\n    name = upload.get(\"name\") if isinstance(upload, dict) else None\n    if not isinstance(name, str) or not name.strip():\n        raise ValueError(f\"{label} did not return a valid Baserow user-file name.\")\n    return upload\n\n\ncv_content = None\nuploads = {}\nfor item in _input.all():\n    item_json = item.json\n    if not isinstance(item_json, dict):\n        continue\n    if isinstance(item_json.get(\"cv_json\"), dict) and \"application_id\" in item_json:\n        cv_content = item_json\n    kind = item_json.get(\"_upload_kind\")\n    if isinstance(kind, str) and isinstance(item_json.get(\"upload\"), dict):\n        uploads[kind] = item_json[\"upload\"]\n\nif cv_content is None:\n    raise ValueError(\"CV content context was not found.\")\ncv_pdf = require_upload(uploads.get(\"cv_pdf\"), \"CV PDF upload\")\ncv_tex = require_upload(uploads.get(\"cv_tex\"), \"CV TEX upload\")\ncover_pdf = require_upload(uploads.get(\"cover_pdf\"), \"Cover letter PDF upload\")\ncover_tex = require_upload(uploads.get(\"cover_tex\"), \"Cover letter TEX upload\")\njob = cv_content.get(\"source_job\") or {}\napplication_id = str(cv_content.get(\"application_id\") or \"application\")\npublished_at = job.get(\"publishedAt\")\ndate_value = str(published_at)[:10] if published_at else datetime.now(timezone.utc).date().isoformat()\nreturn [{\"json\": {\n    \"Job ID\": str(cv_content.get(\"job_id\") or \"\"),\n    \"Date\": date_value,\n    \"Company Name\": job.get(\"companyName\") or \"\",\n    \"Title\": job.get(\"jobTitle\") or \"\",\n    \"Location\": job.get(\"location\") or \"\",\n    \"Job Description\": job.get(\"jobDescription\") or \"\",\n    \"Contract Type\": job.get(\"contractType\") or \"\",\n    \"Cover Letter\": [\n        {\"name\": cover_pdf[\"name\"], \"visible_name\": f\"cover-letter_{application_id}.pdf\"},\n        {\"name\": cover_tex[\"name\"], \"visible_name\": f\"cover-letter_{application_id}.tex\"},\n    ],\n    \"CV\": [\n        {\"name\": cv_pdf[\"name\"], \"visible_name\": f\"cv_{application_id}.pdf\"},\n        {\"name\": cv_tex[\"name\"], \"visible_name\": f\"cv_{application_id}.tex\"},\n    ],\n    \"Link\": job.get(\"jobUrl\") or \"\",\n    \"Status\": \"New\",\n}}]\n"

        "mode": "runOnceForAllItems",
        "language": "pythonNative",
        "pythonCode": "import json\n\n\ndef parse_json(value):\n    if not isinstance(value, str):\n        return value\n    try:\n        return json.loads(value)\n    except (json.JSONDecodeError, TypeError):\n        return value\n\n\ndef unwrap_master_cv(value):\n    current = parse_json(value)\n    for _depth in range(5):\n        if not isinstance(current, dict):\n            break\n        if isinstance(current.get(\"projects\"), list):\n            return current\n        next_value = None\n        found = False\n        for key in (\"master_cv\", \"cv_json\", \"document_data\", \"data\", \"json\"):\n            if key in current:\n                next_value = current[key]\n                found = True\n                break\n        if not found or next_value is current:\n            break\n        current = parse_json(next_value)\n    return current\n\n\ndef is_true(value):\n    if isinstance(value, bool):\n        return value\n    if isinstance(value, (int, float)) and not isinstance(value, bool):\n        return value == 1\n    if isinstance(value, dict):\n        for key in (\"value\", \"name\", \"id\"):\n            if key in value:\n                value = value[key]\n                break\n    return str(value if value is not None else \"\").strip().lower() in {\n        \"true\", \"1\", \"yes\", \"active\", \"enabled\"\n    }\n\n\nmaster_cv = None\ncriteria_rows = []\nfor item in _input.all():\n    item_json = item.json\n    candidate = unwrap_master_cv(item_json)\n    if master_cv is None and isinstance(candidate, dict) and isinstance(candidate.get(\"projects\"), list):\n        master_cv = candidate\n        continue\n    fields = item_json.get(\"fields\") if isinstance(item_json, dict) else None\n    row = fields if isinstance(fields, dict) else item_json\n    if isinstance(row, dict) and (\"Generated URL\" in row or \"Active\" in row):\n        criteria_rows.append(row)\n\nif not isinstance(master_cv, dict):\n    raise ValueError(\"The master CV file must contain a JSON object.\")\nif not isinstance(master_cv.get(\"projects\"), list):\n    raise ValueError(\"The master CV JSON could not be normalized: projects must be an array.\")\n\nseen = set()\nstart_urls = []\nfor row in criteria_rows:\n    url = row.get(\"Generated URL\")\n    if not is_true(row.get(\"Active\")) or not isinstance(url, str) or not url.strip():\n        continue\n    normalized = url.strip()\n    if normalized not in seen:\n        seen.add(normalized)\n        start_urls.append({\"url\": normalized})\n\nif not start_urls:\n    raise ValueError(\"No active Search Criteria rows contain a Generated URL.\")\n\nreturn [{\"json\": {\"master_cv\": master_cv, \"startUrls\": start_urls}}]\n"
      },

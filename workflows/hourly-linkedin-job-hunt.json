        "mode": "runOnceForAllItems",
        "language": "pythonNative",
        "pythonCode": "context = None\njobs = []\nfor item in _input.all():\n    item_json = item.json\n    if isinstance(item_json, dict) and isinstance(item_json.get(\"master_cv\"), dict):\n        context = item_json\n    elif isinstance(item_json, dict):\n        jobs.append(item_json)\n\nif context is None:\n    raise ValueError(\"Pipeline context containing master_cv was not found.\")\nmaster_cv = context.get(\"master_cv\")\nif not isinstance(master_cv, dict):\n    raise ValueError(\"Pipeline master_cv must be an object.\")\n\noutput = []\nfor job in jobs:\n    enriched = dict(job)\n    enriched[\"_pipeline_master_cv\"] = master_cv\n    output.append({\"json\": enriched})\nreturn output\n"
      },
